# Shipped inside the installer as app/backend/.env — the operational settings a
# packaged install runs on.
#
# This file exists because the alternative is silence. Every setting below has a
# fallback baked into the code, so a packaged build with no .env still starts,
# still logs "listening", and still looks healthy — while running on values
# nobody chose. SENSOR_RESEND_ENABLED is the one that matters: it is true here
# and false in code, so losing this file means the server stops asking boards to
# re-send a bullet it missed. Shots simply go absent, with nothing in the log to
# connect them to a configuration problem.
#
# DATABASE_URL, JWT_SECRET, PORT, HOST and LOMAH_STATIC_DIR are deliberately
# ABSENT. The desktop shell passes those in the spawn environment — the database
# and the per-install JWT secret both live under %APPDATA%\LOMAH, which is the
# only writable location once the app is installed under Program Files. dotenv
# never overwrites a variable that is already set, so even if one were added
# here by mistake the shell's value would still win.

JWT_EXPIRES_IN=12h

# ── Sensor UDP (WiFi targets) ─────────────────────────────────────────────────
# Port this server BINDS to receive 9-byte hit frames from every WiFi target.
SENSOR_UDP_LISTEN_PORT=14555
# Port on the TARGET that PLAY/STOP/RESEND are sent TO.
SENSOR_UDP_TARGET_PORT=14550
# Receive buffer. One socket carries every lane's traffic; the default is too
# small once many targets fire at once, and an overflowed buffer drops
# datagrams silently.
SENSOR_UDP_RECV_BUFFER=1048576

# ── Discovery beacon ──────────────────────────────────────────────────────────
# Broadcast so shooter tablets find this server without configuration.
DISCOVERY_PORT=5002
DISCOVERY_INTERVAL_MS=2000

# ── Reliability tuning ────────────────────────────────────────────────────────
RESEND_GRACE_MS=1000
MAX_RESEND_ATTEMPTS=4
MISS_DEBOUNCE_MS=500

# ── Target health ─────────────────────────────────────────────────────────────
TELEMETRY_ONLINE_MS=10000
TELEMETRY_OFFLINE_MS=30000

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Per-datagram logging. OFF in production: console writes block on Windows and
# each log line is a WebSocket fan-out, both on the receive path. That latency
# is exactly what overflows the UDP buffer under sustained fire.
SENSOR_TRACE=false
PLAY_ACK_TIMEOUT_MS=1500
PLAY_MAX_ATTEMPTS=3

SENSOR_REQUIRE_ACK=true
# Ask a board to send a bullet again. The request is 'L' (24 4C n ...), the same
# opcode the board reports hits with — the spec's read example. It used to be
# sent as 'R', which the spec lists as "not implemented", so no resend had ever
# recovered anything.
SENSOR_RESEND_ENABLED=true

NO_DETECT_REREAD=false
NO_DETECT_HOLD_MS=2000
