# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="file:./lomah.db"

# ── HTTP / WebSocket ──────────────────────────────────────────────────────────
PORT=3001
# Bind address. 0.0.0.0 = every interface, which is what lets shooter tablets
# and ESP boards on the range LAN reach this server. 127.0.0.1 would restrict
# it to this machine only — see docs/multi-target-migration-plan.md §3.1.
HOST=0.0.0.0
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# ── Sensor UDP (WiFi targets) ─────────────────────────────────────────────────
# Port this server BINDS to receive 9-byte hit frames from every WiFi target.
SENSOR_UDP_LISTEN_PORT=14555
# Port on the TARGET that PLAY/STOP/RESEND are sent TO.
SENSOR_UDP_TARGET_PORT=14550
# Receive buffer. One socket now carries every lane's traffic; the default is
# too small once many targets fire at once and an overflowed buffer drops
# datagrams silently.
SENSOR_UDP_RECV_BUFFER=1048576

# NOTE: there is deliberately NO global "sensor host" fallback here. Every
# target carries its own address in the database. A lane with no bound target
# must fail loudly rather than quietly targeting some other lane's board.

# ── Discovery beacon ──────────────────────────────────────────────────────────
# Broadcast so shooter tablets can find this server without configuration.
DISCOVERY_PORT=5002
DISCOVERY_INTERVAL_MS=2000

# ── Sensor gate ───────────────────────────────────────────────────────────────
# Range-wide admin "cease fire" flag, held by default at boot until the first
# session starts (or an admin explicitly releases it). Status-only — it does
# not itself block ingestion, see sensor-gate.service.ts.
SENSOR_DEFAULT_HELD=true

# ── Reliability tuning ────────────────────────────────────────────────────────
# How long a skipped bullet number is given to arrive on its own (UDP
# reorders) before we ask the target to re-send it.
RESEND_GRACE_MS=150
MAX_RESEND_ATTEMPTS=2
# Two hits within this window at the miss coordinates count as one miss.
MISS_DEBOUNCE_MS=500

# ── Target health ─────────────────────────────────────────────────────────────
TELEMETRY_ONLINE_MS=10000
TELEMETRY_OFFLINE_MS=30000

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Per-datagram logging. OFF in production: console writes block on Windows and
# each log line is a WebSocket fan-out, both on the receive path. That latency
# is exactly what overflows the UDP buffer under sustained fire.
SENSOR_TRACE=false
PLAY_ACK_TIMEOUT_MS=1500
PLAY_MAX_ATTEMPTS=3
# Refuse to start or resume a stage unless the target acknowledges PLAY.
# ON by default: arming a lane whose board is unpowered or unreachable gives
# a session that looks live while nothing is recording. Set false only for
# bench work with no hardware attached.
SENSOR_REQUIRE_ACK=true
